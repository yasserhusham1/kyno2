# KYNO v2 — Environment Variables Example
# انسخ هذا الملف إلى .env.local وأدخل القيم الفعلية
# لا تُكتب قيم حقيقية في هذا الملف

# ─── Supabase ───────────────────────────────────────
KYNO_SUPABASE_URL=https://your-project.supabase.co
KYNO_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Authentication ─────────────────────────────────
# يجب أن لا يقل JWT_SECRET عن 32 حرفاً
KYNO_JWT_SECRET=your-minimum-32-character-secret-here
KYNO_JWT_EXPIRY=3600
KYNO_REFRESH_TOKEN_EXPIRY=604800

# ─── Application ────────────────────────────────────
KYNO_APP_ENV=development
KYNO_APP_URL=http://localhost:3000
KYNO_APP_NAME=KYNO

# ─── Optional ───────────────────────────────────────
# KYNO_SENTRY_DSN=
# KYNO_WHATSAPP_API_KEY=
# KYNO_MAX_LOGIN_ATTEMPTS=5
# KYNO_LOGIN_LOCKOUT_MINUTES=15
